temp.txt

# Terraform local state, provider cache, variable values, and plan files
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.*
infrastructure/terraform/*.tfvars
infrastructure/terraform/*.tfplan
infrastructure/terraform/crash.log
infrastructure/terraform/crash.*.log

# Local credentials, environment settings, certificates, and OS metadata
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
