# JavaScript dependencies and generated application bundles
node_modules/
lambda/*/node_modules/
dist/

# Generated Lambda deployment archives
lambda/*/function.zip

# Reproducible data products and large source-download cache
data/
public/data/
virginia-*.json

# Exported access records and temporary local investigation files
